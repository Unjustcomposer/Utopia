# Utopia Environment Configuration
# Copy this file to .env and replace the values with your own.

# ==========================================
# Core Application Settings
# ==========================================
# Set to true to enable development mode (disables strict Auth0 verification and uses mock token)
UTOPIA_DEV_MODE=true

# CORS origins allowed to access the FastAPI server (comma-separated)
CORS_ORIGINS=http://localhost:8765,http://localhost:5173

# Postgres or SQLite database connection string
DATABASE_URL=sqlite:///./utopia.db

# ==========================================
# Security & Authentication (Auth0)
# ==========================================
# Secret key used for signing JWTs in dev mode
JWT_SECRET=super_secret_dev_key_change_in_production

# Auth0 Domain (Required for production Auth0 integration)
AUTH0_DOMAIN=your-tenant.auth0.com

# Auth0 API Audience
AUTH0_AUDIENCE=https://api.utopia.com

# ==========================================
# Third-Party Data Connectors
# ==========================================
# FRED API Key for pulling macroeconomic data (https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=your_fred_api_key_here

# USITC API Key for tariff data (https://dataweb.usitc.gov/)
USITC_API_KEY=your_usitc_api_key_here
